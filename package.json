{
	"name": "obsidian-entities",
	"version": "0.4.4",
	"description": "Adds autocomplete of \"Entities\" like files or templates in a specific folder or a from a dataview query.",
	"main": "main.js",
	"engines": {
		"node": "24.21.0",
		"npm": "11.19.0"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs",
		"test": "jest",
		"fixture:recovery": "node scripts/create-recovery-vault.mjs",
		"lint": "eslint src tests scripts \"*.config.{js,mjs}\" version-bump.mjs --max-warnings=0",
		"lint:fix": "eslint src tests scripts \"*.config.{js,mjs}\" version-bump.mjs --fix",
		"check": "npm run lint && npm run release:test && npm test && npm run build",
		"release:check": "npm run check",
		"release:assets": "node scripts/prepare-release-assets.mjs",
		"release:notes": "node scripts/extract-release-notes.mjs",
		"release:publish": "node scripts/publish-release.mjs",
		"release:promote": "node scripts/promote-release.mjs",
		"release:publish:brat": "node scripts/publish-release.mjs --prerelease",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"preversion": "node version-bump.mjs --preflight",
		"release:test": "node --test scripts/tests/*.test.mjs"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/jest": "^29.5.12",
		"@types/node": "^16.18.104",
		"builtin-modules": "3.3.0",
		"esbuild": "0.25.12",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.6.0",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"moment": "^2.30.1",
		"obsidian": "^1.7.2",
		"rollup": "^4.14.2",
		"ts-jest": "^29.1.2",
		"ts-node": "^10.9.2",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.3"
	},
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"emojilib": "^3.0.12"
	}
}
